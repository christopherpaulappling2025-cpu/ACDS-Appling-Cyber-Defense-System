# ACDS Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env.

ACDS_EVENTS_FILE=login_events.json
ACDS_GIT_REPO_PATH=.
ACDS_GIT_BRANCH=main
ACDS_GIT_COMMIT_MSG=ACDS auto-update commit

# Email (SMTP) - Gmail app password recommended
ACDS_EMAIL_SENDER=youremail@gmail.com
ACDS_EMAIL_PASSWORD=your-app-password
ACDS_EMAIL_RECEIVER=youremail@gmail.com

# Slack
ACDS_SLACK_TOKEN=xoxb-your-token
ACDS_SLACK_CHANNEL=#alerts

# Twilio SMS
ACDS_TWILIO_ENABLED=false
ACDS_TWILIO_ACCOUNT_SID=ACxxxx
ACDS_TWILIO_AUTH_TOKEN=xxxx
ACDS_TWILIO_PHONE_NUMBER=+15551234567
ACDS_ALERT_PHONE_NUMBER=+15559876543

# Geolocation
ACDS_GEO_SERVICE=ipapi.co

# Alert threshold (anomaly score)
ACDS_THRESH_ALERT=5

# Server port
PORT=8000
